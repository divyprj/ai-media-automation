# Autonomous AI Media Automation - Environment Configuration
# All configurations operate at an absolute ₹0 expenditure with zero paid dependencies.

# Database Configuration (SQLite with WAL mode)
DATABASE_URL=data/ai_media.db

# Local Ollama Inference (Zero-cost local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=r1:latest

# Local Web Dashboard Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# Safety Controls & Circuit Breakers
ENABLE_EMERGENCY_SHUTOFF=false

# Optional Social Platform Credentials
# (Leave blank to use ₹0 Zero-Cost Mode: Automated Queue + 1-Click Web Intent / Clipboard workflow)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
